<%- include('./layout/header.ejs',{title: indexTitle}) %>

<main class="flex-1">
  <!-- ═══ Hero ═══ -->
  <section class="relative overflow-hidden">
    <!-- Background grid pattern -->
    <div class="pointer-events-none absolute inset-0 bg-grid opacity-[0.04] dark:opacity-[0.06]"></div>

    <div class="container-page relative py-20 md:py-32 lg:py-40">
      <div class="mx-auto max-w-3xl text-center">
        <div class="fadeZoomIn mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-sm text-muted-foreground shadow-soft">
          <span class="flex h-2 w-2 rounded-full bg-accent"></span>
          v1.1.0 — Built with EJS + Webpack 5
        </div>

        <h1 class="text-balance font-display text-4xl font-extrabold leading-tight tracking-tight md:text-6xl lg:text-7xl">
          Compile HTML<br/>
          <span class="text-primary">with Superpowers</span>
        </h1>

        <p class="fadeZoomIn mt-6 text-balance text-lg leading-relaxed text-muted-foreground md:text-xl">
          A modern template for prototyping static sites using EJS,<br class="hidden md:inline"/>
          Tailwind CSS, GSAP, Swiper, and TypeScript.
        </p>

        <div class="fadeZoomIn mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="#features" class="btn-primary w-full sm:w-auto">
            <i class="bi bi-lightning-fill"></i>
            Get Started
          </a>
          <a href="#gallery" class="btn-outline w-full sm:w-auto">
            <i class="bi bi-images"></i>
            View Gallery
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom fade -->
    <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent"></div>
  </section>

  <!-- ═══ Features ═══ -->
  <section id="features" class="container-page py-20 md:py-28">
    <div class="section-title">
      <h2>Everything You Need</h2>
      <p class="mx-auto max-w-2xl">A curated set of modern tools, pre-configured and ready to go.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% features.forEach(function(f) { %>
      <div class="card-hover group p-6">
        <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-xl text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
          <i class="bi <%= f.icon %>"></i>
        </div>
        <h3 class="mb-2 font-display text-lg font-bold"><%= f.title %></h3>
        <p class="text-sm leading-relaxed text-muted-foreground"><%= f.desc %></p>
      </div>
      <% }) %>
    </div>
  </section>

  <!-- ═══ Gallery ═══ -->
  <section id="gallery" class="bg-muted/50 py-20 md:py-28">
    <div class="container-page">
      <div class="section-title">
        <h2>Image Gallery</h2>
        <p class="mx-auto max-w-2xl">A responsive grid layout with scroll-triggered animations.</p>
      </div>

      <div class="mt-14 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
        <% for( let i = 1; i <= 8; i++ ) { %>
        <div class="fadeZoomIn group relative overflow-hidden rounded-2xl">
          <figure class="aspect-square overflow-hidden bg-muted">
            <img
              src="/public/img.jpg"
              alt="Gallery image <%= i %>"
              class="h-full w-full object-cover transition-all duration-500 group-hover:scale-110"
            />
          </figure>
          <div class="pointer-events-none absolute inset-0 flex items-end bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            <span class="p-4 text-sm font-medium text-white">Image <%= String(i).padStart(2, '0') %></span>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ═══ Stats / CountUp ═══ -->
  <section id="stats" class="bg-muted/50 py-20 md:py-28">
    <div class="container-page">
      <div class="section-title">
        <h2>By the Numbers</h2>
        <p class="mx-auto max-w-2xl">Animated counters that trigger when they enter the viewport.</p>
      </div>

      <div
        id="countUpTrigger-0"
        class="mt-14 grid grid-cols-2 gap-6 md:gap-8 lg:grid-cols-4"
      >
        <% stats.forEach(function(s, idx) { %>
        <div class="card p-8 text-center">
          <h3
            class="countUpTrigger-0-item font-display text-4xl font-extrabold text-primary md:text-5xl"
            data-num="<%= s.num %>"
          >
            0
          </h3>
          <span class="countUpTrigger-0-item font-display text-4xl font-extrabold text-primary md:text-5xl" data-no-animate><%= s.suffix %></span>
          <p class="mt-2 text-sm font-medium text-muted-foreground"><%= s.label %></p>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="container-page py-20 md:py-28">
    <div class="fadeZoomIn relative overflow-hidden rounded-3xl bg-primary p-10 text-center md:p-16">
      <div class="pointer-events-none absolute inset-0 bg-grid opacity-[0.06]"></div>

      <div class="relative">
        <h2 class="font-display text-3xl font-extrabold text-primary-foreground md:text-4xl">
          Ready to Build?
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-primary-foreground/80">
          Clone the repo and start prototyping in seconds. No configuration required.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://github.com/Kommm1996/ejs-template" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-primary shadow-soft transition-all duration-200 hover:brightness-95 active:scale-[0.97]">
            <i class="bi bi-github"></i>
            View on GitHub
          </a>
          <a href="https://github.com/Kommm1996/ejs-template/generate" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl border border-primary-foreground/30 bg-transparent px-6 py-3 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:bg-white/10 active:scale-[0.97]">
            <i class="bi bi-plus-circle"></i>
            Use This Template
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Back to top -->
  <div class="fixed bottom-6 right-6 z-40 md:bottom-8 md:right-8">
    <div
      class="flex cursor-pointer items-center justify-center rounded-full border border-border bg-surface/70 p-3 shadow-soft backdrop-blur-lg transition-all duration-200 hover:-translate-y-0.5 hover:shadow-elevated active:scale-95 md:p-3.5"
      @click="toPosi()"
    >
      <i class="bi bi-arrow-up text-foreground"></i>
    </div>
  </div>
</main>

<%- include('./layout/footer.ejs') %>
