<%- include('./html-start.ejs',{title:title}) %>
<header class="sticky top-0 z-50 border-b border-border/50 bg-background/80 backdrop-blur-xl">
  <div class="container-page flex h-16 items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-sm font-bold text-primary-foreground">E</span>
      ejs-template
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-1 md:flex">
      <% navLinks.forEach(function(link) { %>
      <a href="<%= link.href %>" class="btn-ghost rounded-lg text-sm"><%= link.label %></a>
      <% }) %>
      <a href="https://github.com/Kommm1996/ejs-template" target="_blank" rel="noopener noreferrer" class="btn-ghost rounded-lg text-sm">
        <i class="bi bi-github text-base"></i>
        <span class="hidden lg:inline">GitHub</span>
      </a>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <!-- Dark mode toggle -->
      <button class="btn-ghost rounded-lg text-lg" @click="toggleDarkMode(!isDark)" :aria-label="isDark ? 'Switch to light mode' : 'Switch to dark mode'">
        <i class="bi bi-sun-fill" v-if="!isDark"></i>
        <i class="bi bi-moon-fill" v-if="isDark"></i>
      </button>

      <!-- Mobile menu toggle -->
      <button class="btn-ghost rounded-lg text-lg md:hidden" @click="mobileMenuOpen = !mobileMenuOpen">
        <i class="bi bi-list" v-if="!mobileMenuOpen"></i>
        <i class="bi bi-x-lg" v-if="mobileMenuOpen"></i>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="border-t border-border/50 md:hidden" v-if="mobileMenuOpen">
    <nav class="container-page flex flex-col gap-1 py-4">
      <% navLinks.forEach(function(link) { %>
      <a href="<%= link.href %>" class="btn-ghost rounded-lg justify-start text-sm"><%= link.label %></a>
      <% }) %>
      <a href="https://github.com/Kommm1996/ejs-template" target="_blank" rel="noopener noreferrer" class="btn-ghost rounded-lg justify-start text-sm">
        <i class="bi bi-github text-base"></i>
        GitHub
      </a>
    </nav>
  </div>
</header>
