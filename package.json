{
  "name": "ejs-template",
  "version": "1.1.0",
  "description": "A template for compiling HTML using EJS — with Tailwind CSS, GSAP, Swiper, and TypeScript",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "webpack serve --mode=development --devtool=source-map",
    "build": "webpack --mode=production",
    "serve": "npx serve dist -l 8080",
    "test": "node scripts/build-test.js",
    "lint": "eslint src/js/ --ext .ts",
    "format": "prettier --write 'src/**/*.{ejs,ts,css}'"
  },
  "keywords": [
    "ejs",
    "template",
    "webpack",
    "tailwindcss",
    "gsap",
    "swiper",
    "html"
  ],
  "author": "ManWah Kam",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/gsap": "^3.0.0",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "bootstrap-icons": "^1.13.1",
    "clean-webpack-plugin": "^4.0.0",
    "countup.js": "^2.9.0",
    "css-loader": "^6.11.0",
    "ejs": "^3.1.10",
    "esbuild-loader": "^3.2.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "gsap": "^3.13.0",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.9.4",
    "petite-vue": "^0.4.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^7.3.4",
    "prettier": "3.2.5",
    "prettier-plugin-ejs": "^1.0.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "smoothscroll-for-websites": "^1.5.1",
    "swiper": "^8.4.7",
    "tailwindcss": "^3.4.17",
    "template-ejs-loader": "^0.9.4",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
